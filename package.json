{
  "name": "dwikamekatama",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "deploy": "turbo run deploy -F @dwikamekatama/infra --",
    "destroy": "turbo run destroy -F @dwikamekatama/infra --"
  },
  "dependencies": {
    "@dwikamekatama/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@dwikamekatama/config": "*",
    "@types/node": "^26.2.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "msgpackr-extract": true,
    "workerd": true
  }
}
